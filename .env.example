# --- Ring (set) ---------------------------------------------------------
RING_ID=
RING_SECRET=
RING_HMAC=

# --- Google (after C1-C6) ----------------------------------------------
# base64 of the whole service-account JSON key file
GOOGLE_SA_KEY=
GCAL_ID=                   # her email for the primary calendar, or a comma-separated list
GDRIVE_FOLDER_ID=

# --- App ----------------------------------------------------------------
KIOSK_KEY=            # the frame holds this in localStorage
SEND_PIN=             # family type this on /send
CRON_SECRET=          # Vercel sends this as a bearer token on cron invocations

# --- Stores (appear automatically when attached) ------------------------
BLOB_READ_WRITE_TOKEN=
EDGE_CONFIG=
EDGE_CONFIG_ID=       # ecfg_... , needed for WRITES
VERCEL_API_TOKEN=     # needed for WRITES to Edge Config

# --- Optional -----------------------------------------------------------
LAT=-34.98708
LON=138.53674
TZ_NAME=Australia/Adelaide

# --- Ring device ids (from GET /v1/devices during the spike) -------------
CAM_FRONT=
CAM_DRIVE=
CAM_BACK=
CAM_SHED=
CAM_BELL=
BELL_ASPECT=1/1            # 1/1 for Doorbell Pro 2 / Elite / Battery Plus, else 16/9
CAPTURE_INTERVAL_MIN=30    # whatever Snapshot Capture is set to in the Ring app
